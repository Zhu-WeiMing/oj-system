@startuml
start
:管理员登录系统;
if (权限验证通过?) then (是)
  :进入【提交记录管理】界面;
  :设置筛选条件\n(用户/题目/状态/时间范围);
  :点击【查询】按钮;

  if (数据存在?) then (是)
    :分页展示提交记录列表\n(含用户ID/题目ID/提交时间/判题状态);
    :点击单条记录【详情】按钮;
    :弹窗展示完整信息\n(代码/执行耗时/内存占用/错误日志);
  else (无数据)
    :显示"未找到相关记录"提示;
  endif
else (权限不足)
  :跳转至无权限提示页面;
endif
stop
@enduml